# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*~

# Node (in case any scripts are added later)
node_modules/
npm-debug.log*

# Local sandbox / Playwright artifacts
playwright-report/
test-results/

# Local Claude settings (keep .claude/settings.json if needed but not local overrides)
.claude/settings.local.json

# Captured screenshots (~127MB) — derived artifacts; regenerable by re-running
# stardust:extract. Prototypes don't reference these. Excluded to keep the
# repo cloneable. The captured media + fonts + logo + per-page JSON stay.
stardust/current/assets/screenshots/

# Captured body-prose files + verbatim prototype variants. These contain
# Wheeler's marketing paragraphs verbatim (legitimate working capture for
# the client engagement) but reproduce copyrighted prose. Keep them out of
# the public repo; they stay local for the Wheeler-facing pitch artifact.
# The direction-authorized prototypes (proposed.html files without -verbatim
# suffix) go in the repo as the portfolio artifact.
stardust/current/pages/*.bodies.json
stardust/prototypes/*-verbatim.html
